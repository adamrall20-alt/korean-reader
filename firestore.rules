rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isTester(uid) {
      return request.auth != null && request.auth.uid == uid
        && get(/databases/$(database)/documents/phase10Testers/$(uid)).data.enabled == true;
    }

    match /phase10Accounts/{uid}/phase10Data/{id} {
      allow read: if isTester(uid);
      allow create, update: if isTester(uid) &&
        (
          (id.matches('group-([0-9]|[1-5][0-9]|6[0-3])')
            && request.resource.data.keys().hasOnly(['words'])
            && request.resource.data.words is map && request.resource.data.words.size() <= 1500)
          || (id.matches('device-[0-9a-f-]{36}') && request.resource.data == {'imported': true})
          || (id == 'progress'
            && request.resource.data.keys().hasOnly(['history', 'timeZone', 'importedAt', 'importedCount', 'dailyChanges'])
            && request.resource.data.history is map
            && request.resource.data.timeZone is string
            && request.resource.data.importedAt is int
            && request.resource.data.importedCount is int
            && request.resource.data.dailyChanges is map)
        );
    }
  }
}
